rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{coll}/{id} {
      allow read: if coll in ['bme_devices','bme_meta'];
      allow write: if coll in ['bme_devices','bme_meta']
        && request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
  }
}
